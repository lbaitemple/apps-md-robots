# Google Cloud credentials, model, and language
API_KEY_PATH=/home/ubuntu/.gemini/creds.json
GEMINI_MODEL=gemini-2.5-flash
LANGUAGE_CODE=en-US
LANGUAGE_NAME=en-US-Standard-E
# GOOGLE_CLOUD_PROJECT=your-project-id

# Working mixer and buffered TTS playback settings
AMIXER_CARD=0
AMIXER_CONTROL=PCM
AMIXER_VOLUME=95%
TTS_PLAYBACK_SAMPLE_RATE_HZ=48000
TTS_LATENCY_SECONDS=0.08
TTS_BLOCKSIZE_FRAMES=1024

# Working full-duplex WebRTC AEC and barge-in settings
ENABLE_TTS_BARGE_IN=1
REQUIRE_WEBRTC_AEC=1
AEC_SOURCE_NAME=ai_app8_echo_cancel
AEC_SINK_NAME=ai_app8_echo_cancel_sink
VAD_START_CONFIRM_MS=100
BARGE_IN_CONFIRM_MS=100
BARGE_IN_GUARD_MS=80
BARGE_IN_MAX_GAP_MS=60
BARGE_IN_CANCEL_ON_VAD=1
BARGE_IN_MIN_RMS=120
VAD_AGGRESSIVENESS=1
VAD_END_SILENCE_MS=450
VAD_RMS_FALLBACK_THRESHOLD=500
MIN_SPEECH_MS=300
PRE_ROLL_MS=400
MAX_UTTERANCE_SECONDS=20

# Google Speech-to-Text and Translation
GOOGLE_STT_LOCATION=us
GOOGLE_STT_LANGUAGE_CODES=auto
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_RECOGNIZER=_
GOOGLE_STT_FINAL_TIMEOUT=8
GOOGLE_STT_FALLBACK_LANGUAGE_CODES=es-ES,cmn-CN,fr-FR
GOOGLE_TRANSLATE_TIMEOUT=5

# Optional hardware overrides. Leave unset to use the current default devices.
# AEC_MASTER_SOURCE=alsa_input.platform-soc_sound.stereo-fallback
# AEC_MASTER_SINK=alsa_output.platform-bcm2835_audio.stereo-fallback
# WEBRTC_AEC_ARGS=
# MIC_INPUT_DEVICE=pulse
# TTS_OUTPUT_DEVICE=pulse

# PULSE_SOURCE and PULSE_SINK are set automatically by ai_app8.py after AEC
# setup and should not normally be defined here.
