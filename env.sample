API_KEY_PATH=/home/ubuntu/.gemini/creds.json
GEMINI_MODEL=gemini-2.5-flash
AMIXER_CONTROL=PCM

ENABLE_TTS_BARGE_IN=1

GOOGLE_STT_LOCATION=us
GOOGLE_STT_LANGUAGE_CODES=auto

# Optional barge-in/VAD tuning; shown values are the built-in defaults.
# BARGE_IN=1                       # Legacy alias; do not set with ENABLE_TTS_BARGE_IN.
# ENABLE_ECHO_CANCELLATION=1
# BARGE_IN_CONFIRM_MS=100
# AEC_CONVERGENCE_MS=400
# VAD_THRESH=0.6
# MIN_SPEECH_MS=500
# MIN_SILENCE_MS=1200
# TTS_LISTEN_COOLDOWN_MS=500

# Optional model and speech-service overrides.
# GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_STT_LOCATION=us
# GOOGLE_STT_LANGUAGE_CODES=auto
# GOOGLE_STT_RECOGNIZER=_
# GOOGLE_STT_FINAL_TIMEOUT=8

# Optional audio routing overrides. ai_app9 creates and uses the named WebRTC
# endpoints directly; normally none of these need to be set.
# AMIXER_CONTROL=PCM
# AEC_SOURCE_NAME=ai_app9_webrtc_capture
# AEC_SINK_NAME=ai_app9_webrtc_playback
# AEC_MASTER_SOURCE=alsa_input.platform-soc_sound.stereo-fallback
# AEC_MASTER_SINK=alsa_output.platform-bcm2835_audio.stereo-fallback
# MIC_INPUT_DEVICE=
# TTS_OUTPUT_DEVICE=

# Optional LiveTalking integration.
# LIVETALKING_BASE_URL=http://127.0.0.1:8010
# LIVETALKING_SESSION_ID=0

# Optional language override.
# LANGUAGE_CODE=ja-JP
# LANGUAGE_NAME=ja-JP-Neural2-B
